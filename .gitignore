
# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python

# ==========================================
# Virtual environments
# ==========================================
venv/
.venv/
env/
ENV/
virtualenv/

# ==========================================
# Django
# ==========================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-*
media/
staticfiles/
static_root/

# ==========================================
# Database files
# ==========================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlitedb

# ==========================================
# Django migrations
# Ignore migration files inside every app,
# but keep each migrations/__init__.py
# ==========================================
**/migrations/*
!**/migrations/__init__.py

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample

# ==========================================
