# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test-results/
coverage.xml

# ==========================================
# Type checkers and linters
# ==========================================
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.pytype/

# ==========================================
# Build and distribution
# ==========================================
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# ==========================================
