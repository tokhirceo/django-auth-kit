# accounts: muhit o'zgaruvchilari namunasi (haqiqiy sirlarsiz)
# Faqat kerakli qatorlarni oching; berilmaganlari standart qiymat bilan ishlaydi.

ACCOUNTS_REQUIRE_EMAIL_VERIFICATION=false
ACCOUNTS_SITE_URL=https://example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=<env'dan>
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Sayt <noreply@example.com>
SERVER_EMAIL=server@example.com
